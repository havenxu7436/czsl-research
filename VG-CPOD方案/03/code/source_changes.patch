+                config = ROOT / ('configs/round_a/' if case.startswith('A') else 'configs/round_b/') / (case + '.json')
+                cfg = read_json(config)
+                cfg.update(rank=small['rank'], adapter_rank=small['adapter_rank'], workers=0,
