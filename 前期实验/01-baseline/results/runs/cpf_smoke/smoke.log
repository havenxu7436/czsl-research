DATASET:
  name: ut-zappos
  root_dir: /data/xhw/czsl_repro/data/ut-zap50k
  splitname: compositional-split-natural
EVAL:
  open_world: False
  topk: 1
MODEL:
  attn_normalized: True
  classifier: cosine
  cosine_cls_temp: 0.05
  emb_dim: 300
  img_emb_dim: 768
  img_emb_drop: 0.35
  lambda_attn: 10.0
  load_checkpoint: None
  name: OADIS
  optim_weights: 
  use_attr_loss: True
  use_composed_pair_loss: True
  use_emb_pair_loss: True
  use_obj_loss: True
  weights: 
  wordemb_compose: 
  wordemb_compose_dropout: 0.2
  wordembs: glove
TRAIN:
  aug_epoch: 999
  batch_size: 4
  checkpoint_dir: /data/xhw/czsl_repro/runs/cpf_smoke/checkpoints
  comb_features: False
  decay_factor: 0.1
  decay_strategy: milestone
  disp_interval: 283
  eval_every_epoch: 1
  final_max_epoch: 1
  finetune_backbone: True
  log_dir: /data/xhw/czsl_repro/runs/cpf_smoke/logs
  lr: 0.0001
  lr_decay_milestones: [23, 30]
  lr_encoder: 1e-05
  lr_word_embedding: 2.5e-06
  max_epoch: 1
  num_workers: 0
  save_every_epoch: 1
  seed: 3351
  start_epoch: 1
  start_epoch_validate: 1
  test_batch_size: 8
  train_name: final_predcition_mul
  use_precomputed_features: False
  wd: 5e-05
