*.py[cod]
**/*_deps/
**/math_render_deps/
**/node_modules/
**/.venv/
**/venv/
.pytest_cache/
.mypy_cache/

# Credentials never belong in the archive
.env
.env.*
!.env.example
*.pem
*.key
.git-credentials

# OS/editor local state
.DS_Store
Thumbs.db
.idea/
/archive_inputs/referenced_sources/**/downloads/glove.*.zip

