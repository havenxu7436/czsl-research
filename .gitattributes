# The slim branch contains text documentation, source and configuration only.
# Large experiment artifacts are intentionally kept outside Git/LFS.
* text=auto
*.md text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
